# ============================================================
# price-comparator-tracker 环境变量配置模板
# 复制此文件为 .env 并填入实际值：cp .env.example .env
# ============================================================

# ===== GitHub 配置 =====
# 用于访问 GitHub API 的 Token（可选，提升速率限制）
PRICE_TRACKER_GH_TOKEN=
# 仓库所有者（用于 GitHub Release 检查）
PRICE_TRACKER_GH_OWNER=

# ===== 爬虫配置 =====
# 请求超时（秒，默认 15）
REQUEST_TIMEOUT=15
# 请求间隔（秒，默认 2）
REQUEST_DELAY=2
# User-Agent（留空使用默认值）
USER_AGENT=

# ===== 数据存储 =====
# 数据目录（默认 ./data）
DATA_DIR=./data
# 历史记录保留天数（默认 90）
HISTORY_RETENTION_DAYS=90
